{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"realty-host": {
			"projectType": "application",
			"schematics": {},
			"root": "projects/realty-host",
			"sourceRoot": "projects/realty-host/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"outputPath": "dist/realty-host",
						"index": "projects/realty-host/src/index.html",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "projects/realty-host/tsconfig.app.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/realty-host/public",
								"output": "."
							}
						],
						"styles": [
							"projects/realty-host/src/styles.css"
						],
						"scripts": [],
						"main": "projects/realty-host/src/main.ts",
						"extraWebpackConfig": "projects/realty-host/webpack.config.js",
						"commonChunk": false
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "2kB",
									"maximumError": "4kB"
								}
							],
							"outputHashing": "all",
							"extraWebpackConfig": "projects/realty-host/webpack.prod.config.js"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "realty-host:build:production",
							"extraWebpackConfig": "projects/realty-host/webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "realty-host:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200,
						"publicHost": "http://localhost:4200",
						"extraWebpackConfig": "projects/realty-host/webpack.config.js"
					}
				},
				"extract-i18n": {
					"builder": "@angular-devkit/build-angular:extract-i18n"
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/realty-host/tsconfig.spec.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/realty-host/public"
							}
						],
						"styles": [
							"projects/realty-host/src/styles.css"
						],
						"scripts": []
					}
				}
			}
		},
